{
  "name": "@pulseboard/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Contracts shared between the PulseBoard API and web app. Contains no business logic, no I/O and no dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}

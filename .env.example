# PulseBoard API configuration.
#
# Copy to `.env` and adjust. `.env` is git-ignored; this file is the documented
# contract. Every variable is read and validated by apps/api/src/config.ts, which
# fails fast on unknown/invalid values instead of silently defaulting.
#
# All variables are optional: the defaults below are what the API uses when a
# variable is absent.

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Maximum accepted JSON request body size in bytes.
BODY_LIMIT_BYTES=1048576

# How long graceful shutdown may take before the process is forced to exit.
SHUTDOWN_TIMEOUT_MS=10000

# --- Database --------------------------------------------------------------
# SQLite file path, relative to the apps/api package root.
# Use :memory: for an ephemeral database.
DATABASE_FILE=./data/pulseboard.sqlite
# SQLite busy timeout in milliseconds.
DATABASE_BUSY_TIMEOUT_MS=5000
# Apply pending migrations during startup.
DATABASE_AUTO_MIGRATE=true

# --- CORS ------------------------------------------------------------------
# The web app runs on a different origin in development, so the API needs an
# explicit allowlist. Never use `*` together with credentials.
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# --- Web app ---------------------------------------------------------------
# Consumed by apps/web at build time (VITE_ prefix is required by Vite).
VITE_API_BASE_URL=http://127.0.0.1:3000